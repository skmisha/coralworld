  "blocks": [
    {
      "type": "heading",
      "level": 1,
      "text": "The Underwater Observatory Tower"
    },
    {
      "type": "heading",
      "level": 2,
      "text": ""
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Dive in,"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "without getting wet!"
    },
    {
      "type": "paragraph",
      "text": "Experience the only active underwater observatory in the world.",
      "html": "Experience the only active underwater observatory in the world."
    },
    {
      "type": "paragraph",
      "text": "Feel the amazing and vibrant reef as you venture out from the shore to our completely unique viewing point, which sits in the Red Sea and in the reef.",
      "html": "Feel the amazing and vibrant reef as you venture out from the shore to our completely unique viewing point, which sits in the Red Sea and in the reef."
    },
    {
      "type": "paragraph",
      "text": "From this exclusive vantage point, walk down the stairs, to 6 meters below sea level.",
      "html": "From this exclusive vantage point, walk down the stairs, to 6 meters below sea level."
    },
    {
      "type": "paragraph",
      "text": "Here you can watch hundreds of species of fish, coral and invertebrates in their everyday lives and natural surroundings, in the magnificent Red Sea.",
      "html": "Here you can watch hundreds of species of fish, coral and invertebrates in their everyday lives and natural surroundings, in the magnificent Red Sea."
    },
    {
      "type": "paragraph",
      "text": ".The observatory is not accessible to kids strollers *",
      "html": "&nbsp; .The observatory is not accessible to kids strollers *"
    }
  ],
