    },
    {
      "type": "heading",
      "level": 2,
      "text": "צב ים קרני"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "בית גידול לאורך חופים ושוניות, עד עומק של 25 מטרים",
        "גודל עד 1.0 מטרים",
        "משקל עד 100 קילוגרם",
        "תזונה ניזון ממלפפוני ים, שושנות ים, ספוגים ומדוזות"
      ]
    },
    {
      "type": "image",
      "src": "https://coralworld.co.il/wp-content/uploads/2020/05/%D7%A6%D7%91-%D7%99%D7%9D-%D7%A7%D7%A8%D7%A0%D7%99-%D7%92%D7%93%D7%95%D7%9C-%D7%9E%D7%A7%D7%95%D7%93%D7%93.jpg",
      "alt": "צב ים קרני",
      "width": 788,
      "height": 517
    },
    {
      "type": "heading",
      "level": 2,
      "text": "צב ים ירוק"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "בית גידול לאורך החופים עד עומק של 40 מטרים",
        "גודל עד 1.20 מטרים",
        "משקל עד 250 קילוגרם",
        "תזונה ניזון מאצות, עשבי ים, מדוזות ו... חסה"
      ]
    },
    {
      "type": "image",
