      "src": "https://coralworld.co.il/wp-content/uploads/2020/05/scales.png",
      "alt": "scales icon",
      "width": 44,
      "height": 45
    },
    {
      "type": "image",
      "src": "https://coralworld.co.il/wp-content/uploads/2020/05/knife-fork.png",
      "alt": "knife-fork icon",
      "width": 44,
      "height": 45
    },
    {
      "type": "image",
      "src": "https://coralworld.co.il/wp-content/uploads/2020/05/%D7%A6%D7%A0%D7%99%D7%A0%D7%99%D7%AA-%D7%92%D7%93%D7%95%D7%9C-%D7%9E%D7%A7%D7%95%D7%93%D7%93.jpg",
      "alt": "דג",
      "width": 788,
