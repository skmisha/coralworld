  "blocks": [
    {
      "type": "image",
      "src": "https://coralworld.co.il/%D7%9E%D7%A9%D7%A4%D7%97%D7%AA-%D7%94%D7%A0%D7%A6%D7%A8%D7%A0%D7%99%D7%99%D7%9D/",
