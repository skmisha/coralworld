    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "בית גידול פעילי יום ולילה, לרוב נמצאים במערות בשעות היום",
        "גודל עד 35 ס\"מ",
        "משקל עד 2 קילוגרם",
        "תזונה ניזון מדגים ומחסרי חוליות"
      ]
    },
    {
      "type": "image",
      "src": "https://coralworld.co.il/wp-content/uploads/2020/05/zahron-big.jpg",
