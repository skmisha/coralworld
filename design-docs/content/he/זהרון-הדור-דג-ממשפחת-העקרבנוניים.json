  "blocks": [
    {
      "type": "image",
      "src": "https://coralworld.co.il/wp-content/uploads/2020/06/%D7%96%D7%94%D7%A8%D7%95%D7%9F-%D7%94%D7%93%D7%95%D7%A8-%D7%93%D7%92-%D7%94%D7%A9%D7%9E%D7%A9.-%D7%93%D7%92%D7%99%D7%9D-%D7%A0%D7%93%D7%99%D7%A8%D7%99%D7%9D.jpg",
